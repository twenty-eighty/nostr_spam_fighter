POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nostr_spam_fighter_dev
DATABASE_URL=ecto://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB
SECRET_KEY_BASE=
PHX_HOST=localhost
# Required in production (64-character hex Nostr pubkey).
INITIAL_ADMIN_PUBKEY=
# nsec or 64-character hex. Do not store this in a file under the app.
MODERATION_NSEC=
MAX_REDIRECTS=8
CONNECT_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=10000
URL_TIMEOUT_MS=20000
MAX_URLS_PER_EVENT=50
HTTP_CONCURRENCY=20
PER_HOST_CONCURRENCY=4
BATCH_MODERATION_LIMIT=500
INGEST_SINCE_S=86400
INGEST_LIMIT=300
INGEST_CONCURRENCY=2
BLOCKLIST_CONNECT_TIMEOUT_MS=15000
BLOCKLIST_RECEIVE_TIMEOUT_MS=120000
