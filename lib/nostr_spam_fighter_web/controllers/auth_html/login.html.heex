<div class="mx-auto max-w-xl py-16">
  <p class="text-sm tracking-[0.3em] uppercase">Pareto</p>
  <h1 class="mt-4 text-4xl font-semibold">Nostr Spam Fighter</h1>
  <p class="mt-3 text-base opacity-80">
    Sign in with a NIP-07 extension. The server verifies a NIP-98 request and opens an admin session.
  </p>
  <button id="nip07-login" class="btn btn-primary mt-8" type="button">Sign in with Nostr</button>
  <p id="login-error" class="mt-4 text-error hidden"></p>
</div>

<script>
  document.getElementById("nip07-login").addEventListener("click", async () => {
    const error = document.getElementById("login-error")
    error.classList.add("hidden")
    try {
      if (!window.nostr) throw new Error("NIP-07 extension not found")
      const url = window.location.origin + "/auth/nostr"
      const event = {
        kind: 27235,
        created_at: Math.floor(Date.now() / 1000),
        tags: [["u", url], ["method", "POST"]],
        content: ""
      }
      const signed = await window.nostr.signEvent(event)
      const encoded = btoa(JSON.stringify(signed))
      const response = await fetch(url, {
        method: "POST",
        headers: {
          "Authorization": "Nostr " + encoded,
          "Accept": "application/json",
          "x-csrf-token": document.querySelector("meta[name='csrf-token']").content
        }
      })
      const body = await response.json()
      if (!response.ok || !body.ok) throw new Error(body.error || "Login failed")
      window.location = body.redirect
    } catch (e) {
      error.textContent = e.message
      error.classList.remove("hidden")
    }
  })
</script>
